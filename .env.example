# ============================================================
# 环境变量示例文件 —— 复制为 .env 后填入真实值，切勿提交 .env
# 前端变量（Vite）以 VITE_ 开头，构建时会内联进产物，仅放可公开的 key
# 后端/云函数变量通过各平台控制台的环境变量/Secret 注入
# ============================================================

# ---------- 前端 (src/, Vite: import.meta.env) ----------
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_REST=https://your_project_ref.supabase.co/rest/v1
VITE_CLOUDBASE_ENV_ID=your_cloudbase_env_id
# 仅本地开发直连时用到；生产环境请走云函数代理，避免密钥下发到浏览器
VITE_ZHIPU_API_KEY=your_zhipu_api_key
VITE_BAIDU_OCR_API_KEY=your_baidu_ocr_api_key
VITE_BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key

# ---------- 云函数 / Serverless (process.env) ----------
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# service_role 密钥权限极高，只能放在服务端环境变量，绝不可出现在前端
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
BAIDU_OCR_API_KEY=your_baidu_ocr_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key
ZHIPU_API_KEY=your_zhipu_api_key
# supabase-keepalive 探活地址
SUPABASE_KEEPALIVE_URL=https://your_project_ref.supabase.co/rest/v1/shenlun_questions?select=province&limit=1
